# ---------------------------------POSTGRES ------------------------------------

# Postgres root
POSTGRES_USER=pguser
POSTGRES_PASSWORD=pgpassword
POSTGRES_DB=pgdb

# Ingestor's postgres user
MEASUREMENTS_SCHEMA=ingestor_schema
INGESTOR_PG_USER=ingestor_user
INGESTOR_PG_PASSWORD=ingestor_password

# Processor's postgres user
PROCESSED_SCHEMA=processor_schema
PROCESSOR_PG_USER=processor_user
PROCESSOR_PG_PASSWORD=processor_password

# --------------------------------INGESTOR -------------------------------------


# ------------------------------- PROCESSOR ------------------------------------

PROCESSOR_MAX_CONCURRENT_JOBS=3
PROCESSOR_OUTPUT_DIR=./output

# ----------------------------------- KONG -------------------------------------

KONG_DB_USER=kong
KONG_DB_PASSWORD=kong_password
KONG_DB_SCHEMA=kong_schema
